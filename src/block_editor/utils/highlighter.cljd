(ns block-editor.utils.highlighter
  "Edit-mode wiki link Delta formats + read-mode tappable TextSpans.
   Extracted from notes-app.ui.highlighter / reader span builder."
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/gestures.dart" :as gestures]
            [clojure.string :as str]
            [block-editor.utils.inline :as inline]
            [rich-editor.model.delta :as delta]))

(def ^:private bidi-link-pattern "\\[\\[([^\\]]+)\\]\\]")

(defn compute-link-formats
  "Scan text → Delta retain ops highlighting closed `[[wikilinks]]`.
   Keeps brackets visible (IME/caret friendly). Hosts can apply via middleware."
  [text]
  (if (str/blank? text)
    []
    (let [regex (dart:core/RegExp. bidi-link-pattern)
          matches (seq (.allMatches regex text))]
      (loop [ms matches
             last-idx 0
             ops []]
        (if (empty? ms)
          (let [remaining (- (count text) last-idx)]
            (if (> remaining 0)
              (conj ops (delta/retain remaining))
              ops))
          (let [^dart:core/RegExpMatch match (first ms)
                start-idx (.-start match)
                end-idx (.-end match)
                match-len (- end-idx start-idx)
                retain-len (- start-idx last-idx)
                ops (if (> retain-len 0)
                      (conj ops (delta/retain retain-len))
                      ops)
                ops (conj ops (delta/retain match-len
                                            {:bidi-link true :color "#1E90FF"}))]
            (recur (rest ms) end-idx ops)))))))

(defn- text+spans->segments
  "Absolute content-spans → continuous non-overlapping {:text :attrs} segments."
  [text spans]
  (let [len (count text)
        char-attrs (reduce (fn [acc {:keys [start end attrs]}]
                             (reduce (fn [a i]
                                       (if (and (>= i 0) (< i len))
                                         (update a i merge attrs)
                                         a))
                                     acc
                                     (range start end)))
                           (vec (repeat len {}))
                           (or spans []))]
    (if (empty? text)
      []
      (->> (map vector text char-attrs)
           (partition-by second)
           (map (fn [group]
                  {:text (apply str (map first group))
                   :attrs (second (first group))}))))))

(defn- external-link-span
  [text href base-style on-link-tap]
  (m/TextSpan
   .text text
   .style (.copyWith ^m/TextStyle base-style
                     .color (m/Color 0xFF64B5F6)
                     .decoration m.TextDecoration/overline)
   .recognizer (when (and on-link-tap href)
                 (let [r (gestures/TapGestureRecognizer.)]
                   (set! (.-onTap r)
                         #(on-link-tap {:type :external :url href}))
                   r))))

(defn- block-ref-display
  "Same visible label as wiki-token-spans :block-ref."
  [uuid]
  (str "⚓ " (apply str (take 8 uuid)) "…"))

(defn- token-display-length
  [{:keys [type content]}]
  (case type
    :link (+ 4 (count (or content "")))
    :tag (+ 1 (count (or content "")))
    :block-ref (count (block-ref-display content))
    (count (or content ""))))

(defn wiki-target-at
  "Resolve display-offset → on-link-tap payload, or nil for plain text.
   Offsets must match `build-wiki-text-spans` visible text (incl. `[[…]]`)."
  [raw-text offset]
  (let [text (or raw-text "")
        off (max 0 (int (or offset 0)))]
    (loop [tokens (inline/parse-text-spans text)
           pos 0]
      (when-let [token (first tokens)]
        (let [len (token-display-length token)
              end (+ pos len)]
          (if (and (>= off pos) (< off end))
            (case (:type token)
              (:link :tag) (:content token)
              :block-ref {:type :block :id (:content token)}
              nil)
            (recur (rest tokens) end)))))))

(defn- wiki-token-spans
  "Wiki-only TextSpans (no content-spans).
   When `tappable?` is false, style links but omit recognizers (parent handles taps)."
  ([raw-text base-style on-link-tap]
   (wiki-token-spans raw-text base-style on-link-tap true))
  ([raw-text base-style on-link-tap tappable?]
   (let [tokens (inline/parse-text-spans (or raw-text ""))]
     (if (empty? tokens)
       [(m/TextSpan .text "" .style base-style)]
       (mapv
        (fn [{:keys [type content]}]
          (case type
            :text
            (m/TextSpan .text content .style base-style)

            :link
            (m/TextSpan
             .text (str "[[" content "]]")
             .style (.copyWith ^m/TextStyle base-style
                               .color (m/Color 0xFF64B5F6)
                               .fontWeight m.FontWeight/bold
                               .decoration m.TextDecoration/overline)
             .recognizer (when (and tappable? on-link-tap)
                           (let [r (gestures/TapGestureRecognizer.)]
                             (set! (.-onTap r) #(on-link-tap content))
                             r)))

            :tag
            (m/TextSpan
             .text (str "#" content)
             .style (.copyWith ^m/TextStyle base-style
                               .color (m/Color 0xFFBA68C8)
                               .fontStyle m.FontStyle/italic)
             .recognizer (when (and tappable? on-link-tap)
                           (let [r (gestures/TapGestureRecognizer.)]
                             (set! (.-onTap r) #(on-link-tap content))
                             r)))

            :block-ref
            (m/TextSpan
             .text (block-ref-display content)
             .style (.copyWith ^m/TextStyle base-style
                               .color (m/Color 0xFFB0BEC5)
                               .fontSize (max 10.0 (- (or (.-fontSize ^m/TextStyle base-style) 16.0) 2.0))
                               .backgroundColor (m/Color 0xFF263238)
                               .decoration m.TextDecoration/underline
                               .decorationStyle m.TextDecorationStyle/dashed)
             .recognizer (when (and tappable? on-link-tap)
                           (let [r (gestures/TapGestureRecognizer.)]
                             (set! (.-onTap r) #(on-link-tap {:type :block :id content}))
                             r)))

            (m/TextSpan .text (str content) .style base-style)))
        tokens)))))

(defn- apply-basic-attrs
  "Apply bold/italic/underline from content-span attrs onto a TextStyle."
  [^m/TextStyle base-style attrs]
  (let [s (if (:bold attrs)
            (.copyWith base-style .fontWeight m.FontWeight/bold)
            base-style)
        s (if (:italic attrs)
            (.copyWith s .fontStyle m.FontStyle/italic)
            s)
        s (if (:underline attrs)
            (.copyWith s .decoration m.TextDecoration/underline)
            s)]
    s))

(defn build-wiki-text-spans
  "Parse wiki markup into TextSpans for MongolText.rich / MglSelectableText.
   Optional `content-spans` render `:href`/`:link` as external hyperlinks.
   `on-link-tap` receives a page/tag string, `{:type :block :id uuid}`,
   or `{:type :external :url ...}`.
   Pass `tappable?` false when a parent GestureDetector owns taps (avoids arena fights)."
  ([raw-text base-style on-link-tap]
   (build-wiki-text-spans raw-text nil base-style on-link-tap true))
  ([raw-text content-spans base-style on-link-tap]
   (build-wiki-text-spans raw-text content-spans base-style on-link-tap true))
  ([raw-text content-spans base-style on-link-tap tappable?]
   (let [text (or raw-text "")
         spans (or content-spans [])]
     (cond
       (empty? text)
       [(m/TextSpan .text "" .style base-style)]

       (empty? spans)
       (wiki-token-spans text base-style on-link-tap tappable?)

       :else
       (vec
        (mapcat
         (fn [{:keys [text attrs]}]
           (let [href (:href attrs)
                 is-link? (or (:link attrs) href)]
             (if is-link?
               [(if tappable?
                  (external-link-span text href base-style on-link-tap)
                  (m/TextSpan
                   .text text
                   .style (.copyWith ^m/TextStyle base-style
                                     .color (m/Color 0xFF64B5F6)
                                     .decoration m.TextDecoration/overline)))]
               (wiki-token-spans text
                                 (apply-basic-attrs base-style attrs)
                                 on-link-tap
                                 tappable?))))
         (text+spans->segments text spans)))))))
