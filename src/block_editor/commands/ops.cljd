(ns block-editor.commands.ops
  "Handles document-level structural mutations (splitting, merging, deleting, reordering, nesting).
   Fully tree-aware to support hierarchical nested blocks.
   Automatically integrates with the history manager for seamless Undo/Redo.
   Maintains an O(1) :parent pointer on all blocks for ultra-fast structural lookups."
  (:require [rich-editor.commands.text-commands :as text-cmd]
            [rich-editor.commands.editor-commands :as editor-cmd]
            [block-editor.utils.collapse :as collapse]
            [block-editor.utils.history :as history]
            [block-editor.commands.navigate :as navigate]
            ["package:flutter/material.dart" :as m]))

;; =============================================================================
;; Tree Traversal Helpers
;; =============================================================================

(defn- find-parent-info 
  "Locates a block in the tree. Prefers the O(1) `:parent` pointer;
   if missing or stale (`index` -1), scans `:root` / `:children`.
   Returns {:parent-id :index :siblings}."
  [state target-id]
  (let [parent-id (navigate/parent-of state target-id)
        siblings  (if (= parent-id :root)
                    (:root state [])
                    (get-in state [:blocks parent-id :children] []))
        index     (.indexOf siblings target-id)]
    (if (>= index 0)
      {:parent-id parent-id
       :index index
       :siblings siblings}
      ;; Stale `:parent` (e.g. JSON that stored :root while the block lives in :children)
      (let [root (:root state [])
            root-idx (.indexOf root target-id)]
        (if (>= root-idx 0)
          {:parent-id :root :index root-idx :siblings root}
          (or (some (fn [[id b]]
                      (let [chs (:children b [])
                            idx (.indexOf chs target-id)]
                        (when (>= idx 0)
                          {:parent-id id :index idx :siblings chs})))
                    (:blocks state {}))
              {:parent-id :root :index -1 :siblings root}))))))

(defn- descendant-ids
  "block-id plus every nested :children id (DFS). Used to recycle a subtree from :blocks."
  [blocks-map block-id]
  (letfn [(walk [id]
            (cons id
                  (mapcat walk (get-in blocks-map [id :children] []))))]
    (walk block-id)))

(defn- unlink-block
  "Remove `block-id` from its parent's `:root` or `:children` list. Does not touch `:blocks`."
  [state block-id]
  (let [{:keys [parent-id]} (find-parent-info state block-id)]
    (if (= parent-id :root)
      (update state :root #(vec (remove #{block-id} %)))
      (update-in state [:blocks parent-id :children]
                 #(vec (remove #{block-id} (or % [])))))))

;; =============================================================================
;; Core Structure Operations (Enter / Backspace)
;; =============================================================================

(defn split-block-at-cursor! 
  "Splits block and inserts the new block as a sibling at the current depth."
  [!state block-id]
  (history/record-snapshot! !state)
  (let [sel (get-in @!state [:blocks block-id :selection])
        offset (if sel (.-extentOffset sel) 0)
        new-id (str "b-" (random-uuid))]
    (swap! !state
           (fn [s]
             (let [block (get-in s [:blocks block-id])
                   content (:content block "")
                   soff (max 0 (min offset (count content)))
                   [sb sa] (text-cmd/divide-spans-for-block (:content-spans block []) soff)
                   {:keys [parent-id index]} (find-parent-info s block-id)
                   
                   ;; 🌟 Initialize the new block with the same parent
                   new-block {:id new-id 
                              :type (if (contains? #{:list-item :blockquote :ordered-list-item :toggle} (:type block)) (:type block) :paragraph)
                              :content (subs content soff) 
                              :content-spans sa 
                              :children []
                              :parent parent-id} 
                   
                   ;; 1. Update text content
                   s1 (-> s
                          (assoc-in [:blocks block-id :content] (subs content 0 soff))
                          (assoc-in [:blocks block-id :content-spans] sb)
                          (assoc-in [:blocks new-id] new-block))
                   
                   ;; 2. Insert into the tree as a sibling
                   insert-idx (inc index)
                   s2 (if (= parent-id :root)
                        (update s1 :root #(vec (concat (subvec % 0 insert-idx) [new-id] (subvec % insert-idx))))
                        (update-in s1 [:blocks parent-id :children] #(vec (concat (subvec (or % []) 0 insert-idx) [new-id] (subvec (or % []) insert-idx)))))]
               (assoc s2 :active-block-id new-id))))
    (:active-block-id @!state)))

(defn merge-with-previous! 
  "Merges block into the VISUALLY previous block (flattened tree). 
   Adopts any children the deleted block had and updates their :parent pointers."
  [!state block-id]
  (let [state-val @!state
        visible-blocks (collapse/get-visible-root (:root state-val) (:blocks state-val))
        idx (.indexOf visible-blocks block-id)]
    (when (> idx 0)
      (history/record-snapshot! !state)
      (let [prev-id (nth visible-blocks (dec idx))
            {:keys [parent-id]} (find-parent-info state-val block-id)
            prev-block (get-in state-val [:blocks prev-id])
            curr-block (get-in state-val [:blocks block-id])
            
            prev-content (:content prev-block "")
            curr-content (:content curr-block "")
            prev-len (count prev-content)
            
            shifted-spans (mapv (fn [span] (-> span (update :start + prev-len) (update :end + prev-len)))
                                (:content-spans curr-block []))
            merged-spans (vec (concat (:content-spans prev-block []) shifted-spans))
            orphaned-children (:children curr-block [])]
        
        (swap! !state
               (fn [s]
                 (let [;; 1. Remove the current block from its parent
                       s1 (if (= parent-id :root)
                            (update s :root #(vec (remove #{block-id} %)))
                            (update-in s [:blocks parent-id :children] #(vec (remove #{block-id} %))))
                       ;; 2. Append text, adopt children, destroy old block
                       s2 (-> s1
                              (assoc-in [:blocks prev-id :content] (str prev-content curr-content))
                              (assoc-in [:blocks prev-id :content-spans] merged-spans)
                              (update-in [:blocks prev-id :children] #(vec (concat (or % []) orphaned-children)))
                              (update :blocks dissoc block-id)
                              (assoc :active-block-id prev-id))]
                   ;; 🌟 3. Update :parent pointers for all adopted children
                   (reduce (fn [acc child-id]
                             (assoc-in acc [:blocks child-id :parent] prev-id))
                           s2
                           orphaned-children))))
        {:prev-id prev-id :new-offset prev-len}))))

(defn delete-cross-block-selection! 
  "Delegates cross-block text deletion to the rich text engine."
  [!state g-sel]
  (history/record-snapshot! !state)
  (editor-cmd/delete-global-selection! !state)
  (let [active-id (:active-block-id @!state)
        sel (get-in @!state [:blocks active-id :selection])]
    {:focus-block active-id :offset (if sel (.-extentOffset sel) 0)}))

;; =============================================================================
;; Nesting Operations (Tab / Shift+Tab)
;; =============================================================================

(defn indent-block! 
  "Moves a block into the :children array of its immediate previous sibling."
  [!state block-id]
  (history/record-snapshot! !state)
  (swap! !state
         (fn [s]
           (if-let [{:keys [parent-id index siblings]} (find-parent-info s block-id)]
             (if (> index 0)
               (let [prev-id (nth siblings (dec index))
                     s1 (if (= parent-id :root)
                          (update s :root #(vec (remove #{block-id} %)))
                          (update-in s [:blocks parent-id :children] #(vec (remove #{block-id} %))))]
                 (-> s1
                     (update-in [:blocks prev-id :children] #(vec (conj (or % []) block-id)))
                     ;; 🌟 Update the parent pointer to the new container
                     (assoc-in [:blocks block-id :parent] prev-id)))
               s)
             s))))

(defn outdent-block! 
  "Moves a block out of its parent's :children array, making it a sibling of its parent."
  [!state block-id]
  (history/record-snapshot! !state)
  (swap! !state
         (fn [s]
           (if-let [{:keys [parent-id index]} (find-parent-info s block-id)]
             (if (not= parent-id :root)
               (let [gp-info (find-parent-info s parent-id)
                     gp-id (:parent-id gp-info)
                     insert-idx (inc (:index gp-info))
                     s1 (update-in s [:blocks parent-id :children] #(vec (remove #{block-id} %)))
                     s2 (if (= gp-id :root)
                          (update s1 :root #(vec (concat (subvec % 0 insert-idx) [block-id] (subvec % insert-idx))))
                          (update-in s1 [:blocks gp-id :children] #(vec (concat (subvec (or % []) 0 insert-idx) [block-id] (subvec (or % []) insert-idx)))))]
                 ;; 🌟 Re-parent to the grandparent
                 (assoc-in s2 [:blocks block-id :parent] gp-id))
               s)
             s))))

;; =============================================================================
;; Reorder & Menu Operations
;; =============================================================================

(defn reorder-block! 
  "Moves a block in the :root vector from old-index to new-index.
   Currently only supports reordering at the root level (parent remains :root)."
  [!state old-index new-index]
  (history/record-snapshot! !state)
  (swap! !state
         (fn [s]
           (let [root (:root s)
                 target-idx (if (> old-index new-index) new-index (dec new-index))
                 block-id (nth root old-index)
                 root-without (vec (concat (subvec root 0 old-index) 
                                           (subvec root (inc old-index))))
                 final-root (vec (concat (subvec root-without 0 target-idx)
                                         [block-id]
                                         (subvec root-without target-idx)))]
             (assoc s :root final-root)))))

(defn delete-block! 
  "Removes a block and its entire descendant subtree from the document."
  [!state block-id]
  (history/record-snapshot! !state)
  (swap! !state
         (fn [s]
           (let [gone (set (descendant-ids (:blocks s) block-id))
                 new-state (-> s
                               (unlink-block block-id)
                               (update :blocks #(reduce dissoc % gone)))]
             (if (contains? gone (:active-block-id s))
               (assoc new-state :active-block-id nil :cursor-visible false)
               new-state)))))

(defn- clone-subtree
  "Deep-copy `block-id` and all nested `:children` into `:blocks` with fresh ids.
   Returns `[new-id state]`. The clone root's `:parent` is `parent-id`.
   Drops transient `:selection`. Missing blocks are skipped (`nil` id)."
  [s block-id parent-id]
  (letfn [(clone [acc id pid]
            (if-let [block (get-in acc [:blocks id])]
              (let [new-id (str "b-" (random-uuid))
                    [child-ids acc']
                    (reduce (fn [[ids st] child-id]
                              (let [[cid st'] (clone st child-id new-id)]
                                (if cid
                                  [(conj ids cid) st']
                                  [ids st'])))
                            [[] acc]
                            (:children block []))]
                [new-id
                 (assoc-in acc' [:blocks new-id]
                           (-> block
                               (dissoc :selection)
                               (assoc :id new-id :parent pid :children child-ids)))])
              [nil acc]))]
    (clone s block-id parent-id)))

(defn- apply-duplicate
  "Pure: deep-copy `block-id` (and descendants) and insert as the next sibling. No history."
  [s block-id]
  (if-let [{:keys [parent-id index]} (find-parent-info s block-id)]
    (let [[new-id s1] (clone-subtree s block-id parent-id)
          insert-idx (inc index)]
      (if-not new-id
        s
        (if (= parent-id :root)
          (update s1 :root #(vec (concat (subvec % 0 insert-idx) [new-id] (subvec % insert-idx))))
          (update-in s1 [:blocks parent-id :children]
                     #(vec (concat (subvec (or % []) 0 insert-idx) [new-id] (subvec (or % []) insert-idx)))))))
    s))

(defn duplicate-block!
  "Deep-copies the block and its nested children, inserting the clone as the next sibling.
   Each cloned block gets a fresh id; `:parent` / `:children` are rewritten so the copy
   is an independent subtree."
  [!state block-id]
  (history/record-snapshot! !state)
  (swap! !state apply-duplicate block-id))

(defn convert-block! 
  "Changes the type of the block."
  [!state block-id new-type]
  (history/record-snapshot! !state)
  (swap! !state assoc-in [:blocks block-id :type] new-type))

(defn convert-blocks!
  "Bulk type change for the given block ids."
  [!state block-ids new-type]
  (when (seq block-ids)
    (history/record-snapshot! !state)
    (swap! !state update :blocks
           (fn [blocks]
             (reduce (fn [acc id]
                       (if (contains? acc id)
                         (assoc-in acc [id :type] new-type)
                         acc))
                     blocks
                     block-ids)))))

;; =============================================================================
;; Bulk Operations & Multi-Select Logic
;; =============================================================================

(defn toggle-block-selection! 
  [!state block-id]
  (swap! !state
         (fn [s]
           (let [sel (:selected-block-ids s #{})
                 new-sel (if (contains? sel block-id) (disj sel block-id) (conj sel block-id))]
             (assoc s :selected-block-ids new-sel :active-block-id nil :cursor-visible false)))))

(defn set-block-selection!
  [!state block-ids]
  (let [ids (set block-ids)]
    (swap! !state
           (fn [s] (cond-> (assoc s :selected-block-ids ids)
                     (seq ids) (assoc :active-block-id nil :cursor-visible false))))))

(defn delete-blocks! 
  [!state block-ids]
  (when (seq block-ids)
    (history/record-snapshot! !state)
    (swap! !state
           (fn [s]
             (let [id-set (set block-ids)
                   gone (into #{} (mapcat #(descendant-ids (:blocks s) %) id-set))
                   ;; Only unlink selection roots; descendants vanish with the parent.
                   s1 (reduce (fn [acc id]
                                (let [parent-id (:parent-id (find-parent-info acc id))]
                                  (if (contains? gone parent-id)
                                    acc
                                    (unlink-block acc id))))
                              s
                              id-set)]
               (-> s1
                   (update :blocks #(reduce dissoc % gone))
                   (assoc :selected-block-ids #{} :active-block-id nil :cursor-visible false)))))))

(defn- forest-roots
  "Among `ids`, drop those whose ancestor is also in the set so a subtree is cloned once."
  [s ids]
  (let [id-set (set ids)]
    (filterv (fn [id]
               (not (some id-set (navigate/ancestor-ids s id))))
             ids)))

(defn duplicate-blocks!
  "Bulk duplicate. One history snapshot so Undo reverts the whole batch.
   Nested selections clone the outer block once (children ride along in the deep copy)."
  [!state block-ids]
  (when (seq block-ids)
    (history/record-snapshot! !state)
    (swap! !state
           (fn [s]
             (-> (reduce apply-duplicate s (forest-roots s block-ids))
                 (assoc :selected-block-ids #{}))))))

(defn indent-selection!
  "Tab / Shift+Tab entry used by rich-editor `:indent` / `:outdent` commands.
   `direction` is 1 (indent) or -1 (outdent)."
  [!state direction]
  (let [selected (:selected-block-ids @!state #{})
        active-id (:active-block-id @!state)]
    (cond
      (seq selected)
      (if (pos? direction)
        (indent-blocks! !state selected)
        (outdent-blocks! !state selected))

      active-id
      (if (pos? direction)
        (indent-block! !state active-id)
        (outdent-block! !state active-id)))))

(defn paste-when-no-focus!
  "Insert clipboard text at the end of the last visible block when nothing is focused."
  [!state raw-text]
  (when (seq raw-text)
    (let [state @!state
          last-id (last (collapse/get-visible-root (:root state) (:blocks state)))]
      (when last-id
        (let [len (count (get-in state [:blocks last-id :content] ""))]
          (text-cmd/insert-string !state last-id len raw-text)
          {:focus-block last-id :offset (+ len (count raw-text))})))))

(defn indent-blocks!
  [!state block-ids]
  (when (seq block-ids)
    (history/record-snapshot! !state)
    (let [visible (collapse/get-visible-root (:root @!state) (:blocks @!state))
          ordered (filterv #(contains? (set block-ids) %) (reverse visible))]
      (doseq [id ordered]
        (swap! !state
               (fn [s]
                 (if-let [{:keys [parent-id index siblings]} (find-parent-info s id)]
                   (if (> index 0)
                     (let [prev-id (nth siblings (dec index))
                           s1 (if (= parent-id :root)
                                (update s :root #(vec (remove #{id} %)))
                                (update-in s [:blocks parent-id :children] #(vec (remove #{id} %))))]
                       (-> s1
                           (update-in [:blocks prev-id :children] #(vec (conj (or % []) id)))
                           ;; 🌟 Bulk sync parent pointer
                           (assoc-in [:blocks id :parent] prev-id)))
                     s)
                   s)))))))

(defn outdent-blocks!
  [!state block-ids]
  (when (seq block-ids)
    (history/record-snapshot! !state)
    (let [visible (collapse/get-visible-root (:root @!state) (:blocks @!state))
          ordered (filterv #(contains? (set block-ids) %) visible)]
      (doseq [id ordered]
        (swap! !state
               (fn [s]
                 (if-let [{:keys [parent-id index]} (find-parent-info s id)]
                   (if (not= parent-id :root)
                     (let [gp-info (find-parent-info s parent-id)
                           gp-id (:parent-id gp-info)
                           insert-idx (inc (:index gp-info))
                           s1 (update-in s [:blocks parent-id :children] #(vec (remove #{id} %)))
                           s2 (if (= gp-id :root)
                                (update s1 :root #(vec (concat (subvec % 0 insert-idx) [id] (subvec % insert-idx))))
                                (update-in s1 [:blocks gp-id :children] #(vec (concat (subvec (or % []) 0 insert-idx) [id] (subvec (or % []) insert-idx)))))]
                       ;; 🌟 Bulk sync parent pointer
                       (assoc-in s2 [:blocks id :parent] gp-id))
                     s)
                   s)))))))

;; =============================================================================
;; Slash Command Execution
;; =============================================================================

(defn- trailing-slash-token
  "Start index and length of a trailing `/query`, or nil."
  [content]
  (when-let [m (re-find #"/([a-zA-Z0-9]*)$" (or content ""))]
    (let [token (first m)]
      [(- (count content) (count token)) (count token)])))

(defn- execute-slash-insert!
  "Replace the trailing `/query` with `value` via delete-range + insert-string
   so `:content-spans` stay aligned."
  [!state block-id cmd]
  (history/record-snapshot! !state)
  (let [content (get-in @!state [:blocks block-id :content] "")
        value (if (:value-fn cmd) ((:value-fn cmd)) (:value cmd ""))]
    (when-let [[start len] (trailing-slash-token content)]
      (text-cmd/delete-range !state block-id start len)
      (text-cmd/insert-string !state block-id start value)
      (editor-cmd/focus-block !state block-id (+ start (count value))))))

(def ^:private slash-atomic-types
  "Atomic blocks are created from the toolbar, not slash conversion."
  #{:image :divider :table :bookmark})

(defn- execute-slash-type-change!
  "Strip the trailing `/query` and convert the current text block.
   Image / divider / bookmark / table are not slash targets."
  [!state block-id command-type]
  (when-not (contains? slash-atomic-types command-type)
    (history/record-snapshot! !state)
    (let [content (get-in @!state [:blocks block-id :content] "")]
      (when-let [[start len] (trailing-slash-token content)]
        (text-cmd/delete-range !state block-id start len)
        (swap! !state assoc-in [:blocks block-id :type] command-type)))))

(defn execute-slash-command!
  [!state block-id cmd-or-type]
  (let [cmd (if (keyword? cmd-or-type) {:type cmd-or-type} cmd-or-type)]
    (case (:action cmd)
      :insert (execute-slash-insert! !state block-id cmd)
      (execute-slash-type-change! !state block-id (:type cmd)))))

;; =============================================================================
;; Operations Registry Export
;; =============================================================================

(def standard-block-ops
  {:split-block-at-cursor! split-block-at-cursor!
   :merge-with-previous! merge-with-previous!
   :indent-block! indent-block!
   :outdent-block! outdent-block!
   :indent-blocks! indent-blocks!
   :outdent-blocks! outdent-blocks!
   :indent-selection! indent-selection!
   :delete-cross-block-selection! delete-cross-block-selection!
   :reorder-block! reorder-block!
   :delete-block! delete-block!
   :duplicate-block! duplicate-block!
   :convert-block! convert-block!
   :convert-blocks! convert-blocks!
   :toggle-block-selection! toggle-block-selection!
   :set-block-selection! set-block-selection!
   :delete-blocks! delete-blocks!
   :duplicate-blocks! duplicate-blocks!
   :execute-slash-command! execute-slash-command!
   :reveal-block! navigate/reveal-block!
   :paste-when-no-focus! paste-when-no-focus!})