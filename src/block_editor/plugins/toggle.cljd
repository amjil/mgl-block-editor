(ns block-editor.plugins.toggle
  "Toggle list block plugin — text block with a collapsible arrow prefix.
   Uses :text-block-wrapper + Positioned to ensure the gesture detector doesn't block text editing."
  (:require ["package:flutter/material.dart" :as m]
            [block-editor.widgets.reader :as reader]
            [block-editor.utils.inline :as inline]
            [block-editor.utils.text :as text]
            [block-editor.utils.collapse :as collapse]))

(defn wrap-toggle
  "Wraps the editable text widget with a toggleable arrow icon above the FIRST column."
  [text-widget id !state _root-index block style _cfg]
  (let [collapsed? (:collapsed? block false)
        has-children? (seq (:children block []))
        col-width (if style (text/get-exact-column-width style) 18.0)
        icon-left-pad (max 0.0 (/ (- col-width 24.0) 2.0))]
    (m/Stack
     .clipBehavior m/Clip.none
     .children
     [;; 1. Core input area: reserve 28px top padding for the arrow icon
      (m/Container
       .padding (m/EdgeInsets.only .top 28.0)
       .child text-widget)
      
      ;; 2. Absolutely positioned arrow: hit area strictly limited to the icon
      (m/Positioned
       .left icon-left-pad
       .top 2.0
       .child
       (m/GestureDetector
        .behavior m/HitTestBehavior.opaque
        .onTap #(collapse/toggle-collapse! !state id)
        .child
        (m/RotatedBox
         .quarterTurns 1 ;; Rotate 90°: collapsed → (↓), expanded → (→) toward children
         .child
         (m/Icon (if collapsed? m/Icons.arrow_right m/Icons.arrow_drop_up)
                 .size 24.0
                 ;; Grayscale color: works on light/dark backgrounds without overpowering text
                 .color (if has-children? m/Colors.grey.shade300 m/Colors.grey.shade700)))))])))

(defn- render-toggle-read
  [block base-style on-link-tap !state]
  (let [collapsed? (:collapsed? block false)
        clean (inline/strip-properties (or (:content block) ""))
        col-width (if base-style (text/get-exact-column-width base-style) 18.0)
        icon-left-pad (max 0.0 (/ (- col-width 24.0) 2.0))]
    (m/Stack
     .clipBehavior m/Clip.none
     .children
     [(m/Container
       .padding (m/EdgeInsets.only .top 28.0)
       .child (reader/wiki-mongol-text-flex clean base-style on-link-tap))
      
      (m/Positioned
       .left icon-left-pad
       .top 2.0
       .child
       (m/GestureDetector
        .behavior m/HitTestBehavior.opaque
        .onTap #(collapse/toggle-collapse! !state (:id block))
        .child
        (m/RotatedBox
         .quarterTurns 1
         .child
         (m/Icon (if collapsed? m/Icons.arrow_right m/Icons.arrow_drop_up)
                 .size 24.0
                 ;; Grayscale color: match edit-mode appearance
                 .color m/Colors.grey))))])))

(defn toggle-plugin
  "Toggle list block."
  []
  {:type :toggle
   :text-block-type? true
   :text-block-wrapper wrap-toggle
   :render-read render-toggle-read})