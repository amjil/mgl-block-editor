(ns block-editor.plugins.task
  "Task checkbox plugin — uses :text-block-wrapper + Stack Alignment/topLeft + exact column width
   to guarantee zero RenderFlex overflow and keep checkbox centered above the first text column."
  (:require ["package:flutter/material.dart" :as m]
            [block-editor.widgets.reader :as reader]
            [block-editor.utils.inline :as inline]
            [block-editor.utils.text :as text]
            [rich-editor.commands.transaction :as tx]))

(defn- block-checked?
  [block]
  (boolean (or (get-in block [:data :checked])
               (get-in block [:attributes :checked?] false))))

(defn- toggle-checked!
  [!state block-id]
  (let [checked? (block-checked? (get-in @!state [:blocks block-id]))]
    (tx/commit-transaction!
     !state
     (tx/make-transaction :ops [(tx/update-data-op block-id {:checked (not checked?)})]
                          :after-selection nil))))

(defn wrap-task
  "Wraps the editable text widget with a checkbox above the FIRST vertical text column.
   Identical to wrap-list-item: zero Column, zero rigid Expanded, zero overflow."
  [text-widget id !state _root-index block style _cfg]
  (let [checked? (block-checked? block)
        ;; 1. Measure the real physical width of a vertical column for the current font size and style
        col-width (if style (text/get-exact-column-width style) 18.0)
        ;; 2. Centering formula: (column width - checkbox width 20.0) / 2.0
        icon-left-pad (max 0.0 (/ (- col-width 20.0) 2.0))]
    (m/Stack
     .alignment m.Alignment/topLeft ;; topLeft lock: checkbox stays fixed above the first column when text wraps
     .clipBehavior m.Clip/none
     .children
     [;; 1. Reserve 28px top padding for the checkbox icon (20px icon + 8px gap)
      (m/Container
       .padding (m.EdgeInsets/only .top 28.0)
       .child text-widget)
      
      ;; 2. Position the checkbox icon on the horizontal center line of the first column
      (m/GestureDetector
       .behavior m.HitTestBehavior/opaque
       .onTap #(toggle-checked! !state id)
       .child
       (m/Padding
        .padding (m.EdgeInsets/only .left icon-left-pad)
        .child
        (m/Icon (if checked? m.Icons/check_box m.Icons/check_box_outline_blank)
                .size 20.0
                .color (if checked? m.Colors/blue m.Colors/grey))))])))

(defn- render-task-read
  [block base-style on-link-tap !state]
  (let [checked? (block-checked? block)
        clean (inline/strip-properties (or (:content block) ""))
        ^m/TextStyle style (if checked?
                             (.copyWith ^m/TextStyle base-style
                                        .decoration m.TextDecoration/lineThrough
                                        .color m.Colors/grey)
                             base-style)
        ;; Read-only mode: same column width measurement and center offset
        col-width (if base-style (text/get-exact-column-width base-style) 18.0)
        icon-left-pad (max 0.0 (/ (- col-width 20.0) 2.0))]
    (m/Stack
     .alignment m.Alignment/topLeft
     .clipBehavior m.Clip/none
     .children
     [(m/Container
       .padding (m.EdgeInsets/only .top 28.0)
       .child (reader/wiki-mongol-text-flex clean style on-link-tap))
      
      (m/GestureDetector
       .behavior m.HitTestBehavior/opaque
       .onTap #(toggle-checked! !state (:id block))
       .child
       (m/Padding
        .padding (m.EdgeInsets/only .left icon-left-pad)
        .child
        (m/Icon (if checked? m.Icons/check_box m.Icons/check_box_outline_blank)
                .color (if checked? m.Colors/blue m.Colors/grey)
                .size 20.0)))])))

(defn task-plugin
  "Task checkbox block. Edit uses :text-block-wrapper around block-node."
  []
  {:type :task
   :text-block-type? true
   :text-block-wrapper wrap-task
   :render-read render-task-read})