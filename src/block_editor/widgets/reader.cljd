(ns block-editor.widgets.reader
  "Inactive (read-mode) block rendering — static Mongol text, no IME/selectable mount.
   Supports wiki markup (`[[link]]`, `#tag`, `((uuid))`) and leading `key:: value` properties."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mongol]
            [cljd.flutter :as f]
            [rich-editor.config :as rich-config]
            [block-editor.commands.navigate :as navigate]
            [block-editor.runtime :as runtime]
            [block-editor.utils.collapse :as collapse]
            [block-editor.utils.inline :as inline]
            [block-editor.utils.highlighter :as highlighter]))

(defn find-plugin
  "Return the first plugin whose :type matches block-type, or nil."
  [plugins block-type]
  (first (filter #(= (:type %) block-type) plugins)))

(defn wiki-mongol-text
  "Tappable wiki-markup MongolText.rich (no Flex wrapper — callers choose Expanded/Flexible).
   Optional `content-spans` enable inline external hyperlinks and basic formats."
  ([text base-style on-link-tap]
   (wiki-mongol-text text nil base-style on-link-tap))
  ([text content-spans base-style on-link-tap]
   (mongol/MongolText.rich
    (m/TextSpan
     .children (highlighter/build-wiki-text-spans text content-spans base-style on-link-tap)))))

(defn wiki-mongol-text-flex
  "Same as wiki-mongol-text, wrapped in Expanded so Mongol text wraps within
   a height-bounded Column (avoids RenderFlex overflow in vertical script)."
  ([text base-style on-link-tap]
   (wiki-mongol-text-flex text nil base-style on-link-tap))
  ([text content-spans base-style on-link-tap]
   (m/Expanded
    .child (wiki-mongol-text text content-spans base-style on-link-tap))))

(defn- render-properties-view
  "Leading `key:: value` panel; values also support wiki markup."
  [props on-link-tap]
  (if (empty? props)
    (m/SizedBox.shrink)
    (m/Container
     .margin (m.EdgeInsets/only .bottom 12.0)
     .padding (m.EdgeInsets/all 8.0)
     .decoration (m/BoxDecoration
                  .color (-> m.Colors/black (.withOpacity 0.04))
                  .borderRadius (m.BorderRadius/circular 4.0)
                  .border (m/Border.all .color (-> m.Colors/black (.withOpacity 0.12))))
     .child
     (m/Column
      .crossAxisAlignment m.CrossAxisAlignment/start
      .mainAxisSize m.MainAxisSize/min
      .children
      (vec
       (map (fn [[k v]]
              (m/Padding
               .padding (m.EdgeInsets/symmetric .vertical 2.0)
               .child
               (mongol/MongolRichText
                .text
                (m/TextSpan
                 .children
                 [(m/TextSpan
                   .text (str k ": ")
                   .style (m/TextStyle .color (m/Color 0xFF9E9E9E)
                                       .fontSize 12.0
                                       .fontWeight m.FontWeight/bold
                                       .fontFamily "OyunQaganTig"))
                  (m/TextSpan
                   .children
                   (highlighter/build-wiki-text-spans
                    v
                    (m/TextStyle .color (m/Color 0xFFD0D0D0)
                                 .fontSize 12.0
                                 .fontFamily "OyunQaganTig")
                    on-link-tap))]))))
            props))))))

(defn- default-read-text
  "Wiki markup + optional properties panel. Fills parent height so body text can wrap.
   Passes `:content-spans` so external hyperlinks render in read mode."
  [block base-style on-link-tap]
  (let [raw (or (:content block) "")
        spans (:content-spans block [])
        props (inline/parse-properties raw)
        clean (inline/strip-properties raw)
        ;; Property strip shifts offsets; only pass spans when no leading props.
        body-spans (when (empty? props) spans)]
    (m/Column
     .mainAxisSize m.MainAxisSize/max
     .crossAxisAlignment m.CrossAxisAlignment/start
     .children
     (filterv some?
              [(when (seq props)
                 (render-properties-view props on-link-tap))
               (wiki-mongol-text-flex clean body-spans base-style on-link-tap)]))))

(defn block-reader-view
  "Static block view for inactive (unfocused) blocks.

   Prefers plugin `:render-read`; otherwise wiki-aware default text.
   Fills parent height (mainAxisSize/max) so nested Expanded text wraps.
   `!state` is passed as the 4th arg to `:render-read` (e.g. image width-ratio)."
  ([block plugins cfg]
   (block-reader-view block plugins cfg nil nil))
  ([block plugins cfg on-link-tap]
   (block-reader-view block plugins cfg on-link-tap nil))
  ([block plugins cfg on-link-tap !state]
   (let [b-type (or (:type block) :paragraph)
         base-style (rich-config/get-block-style cfg b-type)
         plugin (find-plugin plugins b-type)]
     ;; Fill parent height (block_tree wraps this in Expanded) so body text wraps.
     (m/Column
      .mainAxisSize m.MainAxisSize/max
      .crossAxisAlignment m.CrossAxisAlignment/start
      .children
      [(m/Expanded
        .child
        (if (and plugin (:render-read plugin))
          ((:render-read plugin) block base-style on-link-tap !state)
          (default-read-text block base-style on-link-tap)))]))))

;; =============================================================================
;; Document-level preview (no IME / focus / reorder)
;; =============================================================================

(defn- reader-block-snapshot
  "Content-aware snapshot so preview refreshes on persist / remote reload."
  [state id]
  (let [block (get-in state [:blocks id])]
    (when block
      {:id id
       :type (:type block)
       :content (:content block "")
       :content-spans (:content-spans block [])
       :data (:data block)
       :attributes (:attributes block)
       :children (:children block [])
       :collapsed? (boolean (:collapsed? block false))
       :highlighted? (= id (:highlighted-block-id state))})))

(defn- collapse-handle [!state id collapsed?]
  (m/GestureDetector
   .behavior m.HitTestBehavior/opaque
   .onTap #(collapse/toggle-collapse! !state id)
   .child
   (m/Padding
    .padding (m.EdgeInsets/only .bottom 4.0)
    .child
    (m/RotatedBox
     .quarterTurns 1
     .child
     (m/Icon (if collapsed? m.Icons/arrow_right m.Icons/arrow_drop_up)
             .size 16.0
             .color m.Colors/blue)))))

(defn- reader-column
  "One block as static `block-reader-view`, with optional collapse + locate flash."
  [id !state cfg]
  (f/widget
   :watch [snap (f/$ (reader-block-snapshot (f/<! !state) id))]
   (if-not snap
     (m/SizedBox.shrink)
     (let [plugins (:block-plugins cfg [])
           on-link-tap (:on-link-tap cfg)
           block {:id (:id snap)
                  :type (:type snap)
                  :content (:content snap)
                  :content-spans (:content-spans snap)
                  :data (:data snap)
                  :attributes (:attributes snap)
                  :children (:children snap)
                  :collapsed? (:collapsed? snap)}
           show-arrow? (and (seq (:children snap))
                            (not= (:type snap) :toggle))
           body (block-reader-view block plugins cfg on-link-tap !state)]
       (m/KeyedSubtree
        .key (navigate/widget-key !state id)
        .child
        (m/Column
         .crossAxisAlignment m.CrossAxisAlignment/start
         .children
         [(if show-arrow?
            (collapse-handle !state id (:collapsed? snap))
            (m/SizedBox .height 8.0))
          (m/Expanded
           .child
           (m/Padding
            .padding (m.EdgeInsets/only .right 10.0)
            .child
            (if (:highlighted? snap)
              (m/Stack
               .clipBehavior m.Clip/none
               .children
               [body
                (m/Positioned.fill
                 .child
                 (m/IgnorePointer
                  .child
                  (m/Container
                   .decoration (m/BoxDecoration
                                .color (-> m.Colors/amber (.withOpacity 0.22))
                                .border (m/Border.all .color m.Colors/amber .width 1.5)
                                .borderRadius (m.BorderRadius/circular 4.0)))))])
              body)))]))))))

(defn- reader-subtree
  "Root-or-nested preview column plus visible children."
  [id !state cfg]
  (f/widget
   :watch [snap (f/$ (let [b (get-in (f/<! !state) [:blocks id])]
                       {:children (:children b [])
                        :collapsed? (boolean (:collapsed? b false))}))]
   (let [visible (if (:collapsed? snap) [] (:children snap))]
     (m/Row
      .crossAxisAlignment m.CrossAxisAlignment/start
      .mainAxisSize m.MainAxisSize/min
      .children
      (vec
       (cons
        (reader-column id !state cfg)
        (map (fn [child-id]
               (m/Padding
                .key (m/ValueKey child-id)
                .padding (m.EdgeInsets/only .top 32.0)
                .child (reader-subtree child-id !state cfg)))
             visible)))))))

(defn document-reader
  "Full-document preview: `block-reader-view` tree, horizontal scroll, no IME.
   Links, task checkboxes, and toggle collapse still work.
   Optional `:leading-widget` scrolls ahead of the first block."
  [!state cfg & {:keys [padding background-color leading-widget]
                 :or {padding (m.EdgeInsets/all 24.0)
                      background-color m.Colors/transparent}}]
  (f/widget
   :managed [scroll-ctrl (m/ScrollController)
             _rt !state :dispose runtime/release! :refresh-on !state]
   :watch [shell (f/$ (let [s (f/<! !state)]
                        {:root (:root s [])
                         :scroll-to-block-id (:scroll-to-block-id s)}))]
   (let [root-ids (:root shell)
         lead? (boolean leading-widget)
         offset (if lead? 1 0)
         _ (when-let [id (:scroll-to-block-id shell)]
             (m/WidgetsBinding.instance.addPostFrameCallback
              (fn [_]
                (when (= id (:scroll-to-block-id @!state))
                  (navigate/consume-scroll-request! scroll-ctrl !state id))))
             nil)]
     (m/Container
      .color background-color
      .child
      (m/ListView.builder
       .controller scroll-ctrl
       .scrollDirection m/Axis.horizontal
       .padding padding
       .itemCount (+ (count root-ids) offset)
       .itemBuilder
       (fn [_ idx]
         (if (and lead? (zero? idx))
           leading-widget
           (let [id (nth root-ids (- idx offset))]
             (m/KeyedSubtree
              .key (m/ValueKey id)
              .child (reader-subtree id !state cfg))))))))))
