(ns block-editor.widgets.autocomplete
  "Floating `[[wikilink` / `#tag` autocomplete. Candidate sources are injected via
   `:link-suggestions` / `:tag-suggestions` on editor-config —
   `(fn [query] -> seq of strings)`.

   Appearance follows Flutter `Theme` / `ColorScheme` by default. Hosts may
   override via `:link-autocomplete-style` on editor-config:
     {:background Color :border-color Color :divider-color Color
      :splash-color Color :highlight-color Color
      :text-style TextStyle :empty-style TextStyle
      :max-width double :max-height double :item-height double
      :item-min-width double :elevation double :border-radius double}"
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mongol]
            [cljd.flutter :as f]
            [block-editor.runtime :as runtime]
            [block-editor.widgets.slash-menu :as slash-menu]
            [block-editor.widgets.overlay-style :as overlay-style]
            [rich-editor.commands.transaction :as tx]
            [rich-editor.commands.editor-commands :as editor-cmd]))

(defn- ac-atom [!state]
  (:!ac-state (runtime/of !state)))

(defn close-menu!
  [!state]
  (let [!ac (ac-atom !state)]
    (when (:active? @!ac)
      (swap! !ac assoc :active? false :kind nil :query "" :block-id nil))))

(defn- handle-link-select!
  [!state page-name]
  (let [{:keys [block-id query]} @(ac-atom !state)
        block (get-in @!state [:blocks block-id])
        old-text (or (:content block) "")
        target-str (str "[[" query)
        last-idx (.lastIndexOf old-text target-str)
        new-text (if (>= last-idx 0)
                   (str (.substring old-text 0 last-idx) "[[" page-name "]] ")
                   old-text)]
    (tx/commit-transaction!
     !state
     (tx/make-transaction :ops [(tx/update-data-op block-id {:content new-text})]
                          :after-selection nil))
    (editor-cmd/focus-block !state block-id (count new-text))
    (close-menu! !state)))

(defn- handle-tag-select!
  [!state tag-name]
  (let [{:keys [block-id query]} @(ac-atom !state)
        block (get-in @!state [:blocks block-id])
        old-text (or (:content block) "")
        target-str (str "#" query)
        last-idx (.lastIndexOf old-text target-str)
        new-text (if (>= last-idx 0)
                   (str (.substring old-text 0 last-idx) "#" tag-name " ")
                   old-text)]
    (tx/commit-transaction!
     !state
     (tx/make-transaction :ops [(tx/update-data-op block-id {:content new-text})]
                          :after-selection nil))
    (editor-cmd/focus-block !state block-id (count new-text))
    (close-menu! !state)))

(defn- handle-select!
  [!state name]
  (let [kind (:kind @(ac-atom !state))]
    (if (= kind :tag)
      (handle-tag-select! !state name)
      (handle-link-select! !state name))))

(defn- detect-trigger
  "Prefer unclosed `[[…` over trailing `#tag`. Returns
   `{:kind :link|:tag :query string}` or nil."
  [content]
  (let [link-re (dart:core/RegExp. "\\[\\[([^\\]]*)$")
        link-match (first (.allMatches link-re content))]
    (if link-match
      {:kind :link :query (or (.group link-match 1) "")}
      (let [tag-re (dart:core/RegExp. "(?:^|[\\s])#([^\\s#\\[\\]]*)$")
            tag-match (first (.allMatches tag-re content))]
        (when tag-match
          {:kind :tag :query (or (.group tag-match 1) "")})))))

(defn install-sniffer!
  "Watch active block content for unclosed `[[…` or trailing `#…`.
   No-op when the matching suggestions callback is missing.
   Installed once per state atom; writes only this editor's autocomplete state."
  [!state]
  (let [rt (runtime/of !state)
        !installed (:!ac-sniffer-installed rt)
        !ac (:!ac-state rt)]
    (when-not @!installed
      (reset! !installed true)
      (add-watch
       !state runtime/ac-sniffer-watch
       (fn [_ _ _ new-state]
         (let [cfg (:editor-config new-state)
               active-id (:active-block-id new-state)]
           (if-not active-id
             (close-menu! !state)
             (let [content (get-in new-state [:blocks active-id :content] "")
                   hit (detect-trigger content)
                   suggestions (case (:kind hit)
                                 :link (:link-suggestions cfg)
                                 :tag (:tag-suggestions cfg)
                                 nil)]
               (if (and hit suggestions)
                 (reset! !ac {:active? true
                              :kind (:kind hit)
                              :query (:query hit)
                              :block-id active-id})
                 (close-menu! !state))))))))))

(defn- suggestion-item [!state p-name style]
  (m/Material
   .color m.Colors/transparent
   .child
   (m/InkWell
    .onTap #(handle-select! !state p-name)
    .splashColor (:splash-color style)
    .highlightColor (:highlight-color style)
    .child
    (m/Container
     .constraints (m/BoxConstraints .minWidth (:item-min-width style))
     .padding (m.EdgeInsets/symmetric .vertical 14.0 .horizontal 10.0)
     .decoration (m/BoxDecoration
                  .border (m/Border .right
                                    (m/BorderSide
                                     .color (:divider-color style)
                                     .width 1.0)))
     .child
     ;; Mongol text grows vertically — clip long titles inside the panel height.
     (m/SizedBox
      .height (:item-height style)
      .child
      (mongol/MongolText p-name
                         .overflow m.TextOverflow/ellipsis
                         .style (:text-style style)))))))

(defn suggestions-panel
  "Bounded horizontal suggestion list used by link/tag autocomplete."
  [!state pages style]
  ;; Must bound maxWidth: an unbounded horizontal ListView expands to fit all
  ;; children instead of scrolling (which pushed the menu past the viewport).
  (let [radius (m.BorderRadius/circular (:border-radius style))]
    (m/Material
     .elevation (:elevation style)
     .shadowColor (-> m.Colors/black (.withOpacity 0.18))
     .color (:background style)
     .borderRadius radius
     .clipBehavior m.Clip/antiAlias
     .child
     (m/ConstrainedBox
      .constraints (m/BoxConstraints
                    .maxWidth (:max-width style)
                    .maxHeight (:max-height style))
      .child
      (m/DecoratedBox
       .decoration (m/BoxDecoration
                    .borderRadius radius
                    .border (m/Border.all
                             .color (:border-color style)
                             .width 1.0))
       .child
       (if (empty? pages)
         (m/Padding
          .padding (m.EdgeInsets/all 16.0)
          .child (mongol/MongolText "No matches"
                                    .style (:empty-style style)))
         (m/ListView.builder
          .scrollDirection m.Axis/horizontal
          .padding (m.EdgeInsets/symmetric .horizontal 2.0)
          .physics (m/BouncingScrollPhysics.)
          .itemCount (count pages)
          .itemBuilder
          (fn [_ i]
            (suggestion-item !state (nth pages i) style)))))))))

(defn autocomplete-overlay
  "CompositedTransformFollower menu. Requires slash LayerLink on the active block.
   Styles from Theme; optional `:link-autocomplete-style` on cfg."
  [!state cfg]
  (let [!ac (ac-atom !state)]
    (f/widget
     :watch [ac !ac]
     :context ctx
     (let [kind (:kind ac)
           suggestions-fn (case kind
                            :link (:link-suggestions cfg)
                            :tag (:tag-suggestions cfg)
                            nil)]
       (if-not (and (:active? ac) suggestions-fn)
         (m/SizedBox.shrink)
         (let [query (or (:query ac) "")
               pages (vec (or (suggestions-fn query) []))
               style (overlay-style/resolve ctx cfg)]
           (m/CompositedTransformFollower
            .link (slash-menu/slash-layer-link !state)
            .showWhenUnlinked false
            .offset (m/Offset. 40.0 12.0)
            .child (suggestions-panel !state pages style))))))))
